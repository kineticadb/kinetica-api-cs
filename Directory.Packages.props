<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <AvroVersion>1.12.1</AvroVersion>
  </PropertyGroup>

  <ItemGroup>
    <!-- ========== Avro - NEW ========== -->
    <PackageVersion Include="Apache.Avro" Version="$(AvroVersion)" />

    <!-- ========== Core Dependencies (from old Avro.csproj) ========== -->
    <PackageVersion Include="log4net" Version="3.3.1" />
    <PackageVersion Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageVersion Include="System.CodeDom" Version="8.0.0" />
    <PackageVersion Include="System.Configuration.ConfigurationManager" Version="7.0.0" />

    <!-- ========== Kinetica Dependencies ========== -->
    <PackageVersion Include="JDBC.NET.Data" Version="3.5.10" />
    <PackageVersion Include="Microsoft.Extensions.FileSystemGlobbing" Version="10.0.4" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.4" />
    <PackageVersion Include="NetCoreServer" Version="8.0.7" />
    <PackageVersion Include="Snappier" Version="1.3.1" />

    <!-- ========== Example/Test Dependencies ========== -->
    <PackageVersion Include="CommandLineParser" Version="2.9.1" />
    <PackageVersion Include="NetTopologySuite" Version="2.6.0" />
    <PackageVersion Include="Npgsql" Version="9.0.3" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.4" />

    <!-- ========== J2NET Runtime (platform-specific) ========== -->
    <!-- Version defined centrally, conditionally included in projects -->
    <PackageVersion Include="J2NET.Runtime.Mac" Version="1.4.1" />
    <PackageVersion Include="J2NET.Runtime.Linux-x64" Version="1.4.1" />
    <PackageVersion Include="J2NET.Runtime.win-x64" Version="1.4.1" />
    <PackageVersion Include="J2NET.Runtime.win-x32" Version="1.4.1" />

    <!-- ========== Test Frameworks ========== -->
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
    <PackageVersion Include="xunit" Version="2.7.0" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="2.5.7" />
    <PackageVersion Include="Moq" Version="4.20.70" />
    <PackageVersion Include="coverlet.collector" Version="6.0.1" />

    <!-- ========== Benchmarking ========== -->
    <PackageVersion Include="BenchmarkDotNet" Version="0.13.12" />
  </ItemGroup>
</Project>
