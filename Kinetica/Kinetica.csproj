<Project Sdk="Microsoft.NET.Sdk">

  <!-- ========== Multi-Targeting for Modern .NET Support ========== -->
  <!--
    net8.0: Current LTS (most production services)
    net10.0: New LTS (Nov 2025) - primary target for next 3 years

    Note: netstandard2.0 is NOT supported because the codebase uses modern features:
    - System.Threading.Channels (Channel<T>)
    - System.Text.Json
    - IAsyncDisposable, ValueTask
    - RequiresUnreferencedCodeAttribute (trimming annotations)
    For .NET Framework compatibility, use the 7.2.3.x package line.
  -->
  <PropertyGroup>
    <!-- Clear the singular TargetFramework inherited from Directory.Build.props,
         otherwise it overrides multi-targeting and only net8.0 gets built. -->
    <TargetFramework></TargetFramework>
    <TargetFrameworks>net8.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- ========== Trimming / AOT Readiness (net8.0+) ========== -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net8.0' Or '$(TargetFramework)' == 'net10.0'">
    <IsTrimmable>true</IsTrimmable>
    <EnableTrimAnalyzer>true</EnableTrimAnalyzer>
    <!-- AOT not realistic given Avro reflection requirements -->
    <IsAotCompatible>false</IsAotCompatible>
    <!-- The reflection-based Avro types (KineticaData and its generated
         request/response subclasses) are deliberately marked
         [RequiresUnreferencedCode] so that consumers who trim their apps are
         warned.  That same annotation makes the trim analyzer flag our own
         internal usages as noise during this library's build:
           - IL2026: calling a [RequiresUnreferencedCode] member (e.g. each
             generated constructor invoking the KineticaData base ctor).
           - IL2109: deriving from a [RequiresUnreferencedCode] type (every
             generated request/response class derives from KineticaData).
           - IL2075: reflecting over a record's runtime type to read a column
             property by name (e.g. RecordKeyBuilder reading shard-key values
             via record.GetType().GetProperty(name)).  The same reflection that
             makes the API non-trimmable; making it statically trim-safe would
             require cascading [DynamicallyAccessedMembers] onto every caller's
             record type.
         Suppress them here while keeping the annotations intact for downstream
         callers. -->
    <NoWarn>$(NoWarn);IL2026;IL2109;IL2075</NoWarn>
  </PropertyGroup>

  <!-- ========== NuGet Package Metadata ========== -->
  <PropertyGroup>
    <PackageId>Kinetica</PackageId>
    <Title>Kinetica C# API</Title>
    <Description>Official C# API for Kinetica, the real-time analytics database. Provides high-performance data ingestion with BulkInserter, comprehensive database operations, and support for both strongly-typed POCOs and dynamic GenericRecord types. Now with .NET 8 LTS and .NET 10 LTS support.</Description>
    <PackageTags>kinetica;database;analytics;real-time;gpudb;timeseries;geospatial;bulk-insert;avro;net8;net10</PackageTags>
    <PackageProjectUrl>https://github.com/kineticadb/kinetica-api-cs</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/kineticadb/kinetica-api-cs.git</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageReleaseNotes>Adds net8.0 and net10.0 TFMs. Trimming annotations for reflection-heavy APIs. See CHANGELOG for details.</PackageReleaseNotes>
  </PropertyGroup>

  <!-- ========== Common Dependencies (all TFMs) ========== -->
  <ItemGroup>
    <!-- Replaced vendored Avro 0.9.0 with Apache.Avro 1.12.1 NuGet package -->
    <PackageReference Include="Apache.Avro" />
    <PackageReference Include="JDBC.NET.Data" />
    <PackageReference Include="Microsoft.Extensions.FileSystemGlobbing" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="Snappier" />
  </ItemGroup>

  <!-- ========== Additional Dependencies ========== -->
  <ItemGroup>
    <PackageReference Include="NetCoreServer" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Kinetica.Tests" />
    <InternalsVisibleTo Include="AdoDotnetDriver.Tests" />
  </ItemGroup>

  <!-- Include README in package -->
  <ItemGroup>
    <None Include="../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>

</Project>
