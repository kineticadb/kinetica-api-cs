<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Project-specific settings that override Directory.Build.props -->
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <!-- Benchmark code is not a shipped API surface (its public [Benchmark]
         methods are public only so BenchmarkDotNet can discover them), so don't
         emit an XML doc file or require XML comments on public members. -->
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Kinetica\Kinetica.csproj" />
  </ItemGroup>

</Project>
